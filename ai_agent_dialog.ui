     </widget>
     <!-- TAB 2: NATURAL LANGUAGE TO SQL -->
     <widget class="QWidget" name="tab_sql">
      <attribute name="title">
       <string>Ask Data (SQL)</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_sql">
       <item>
        <widget class="QGroupBox" name="groupBox_query">
         <property name="title">
          <string>Your Question</string>
         </property>
         <layout class="QVBoxLayout" name="verticalLayout_query">
          <item>
           <widget class="QPlainTextEdit" name="userQueryInput">
            <property name="placeholderText">
             <string>e.g., Find all schools within 1km of a main road...</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="generateSqlBtn">
            <property name="text">
             <string>▼ Generate SQL ▼</string>
            </property>
            <property name="font">
             <font>
              <weight>75</weight>
              <bold>true</bold>
             </font>
            </property>
            <property name="styleSheet">
             <string notr="true">background-color: #4CAF50; color: white; padding: 8px;</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupBox_sqlResult">
         <property name="title">
          <string>Generated SQL (Editable)</string>
         </property>
         <layout class="QVBoxLayout" name="verticalLayout_sqlResult">
          <item>
           <widget class="QPlainTextEdit" name="sqlResultOutput">
            <property name="font">
             <font>
              <family>Courier New</family>
              <pointsize>10</pointsize>
             </font>
            </property>
            <property name="placeholderText">
             <string>SQL query will appear here...</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="executeSqlBtn">
            <property name="text">
             <string>▶ Execute and Load as Layer</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
     <!-- TAB 3: GEOCODEX CHAT -->
     <widget class="QWidget" name="tab_chat">
      <attribute name="title">
       <string>GeoCodex</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_chat">
       <!-- Chat History Display -->
       <item>
        <widget class="QTextBrowser" name="chatHistoryDisplay">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
           <horstretch>0</horstretch>
           <verstretch>3</verstretch>
          </sizepolicy>
         </property>
         <property name="openExternalLinks">
          <bool>false</bool>
         </property>
         <property name="placeholderText">
          <string>Chat history will appear here...</string>
         </property>
        </widget>
       </item>
       <!-- Image Attachment Preview -->
       <item>
        <widget class="QFrame" name="imageAttachmentFrame">
         <property name="frameShape">
          <enum>QFrame::StyledPanel</enum>
         </property>
         <property name="frameShadow">
          <enum>QFrame::Raised</enum>
         </property>
         <property name="visible">
          <bool>false</bool>
         </property>
         <layout class="QHBoxLayout" name="horizontalLayout_attachment">
          <property name="leftMargin">
           <number>5</number>
          </property>
          <property name="topMargin">
           <number>5</number>
          </property>
          <property name="rightMargin">
           <number>5</number>
          </property>
          <property name="bottomMargin">
           <number>5</number>
          </property>
          <item>
           <widget class="QLabel" name="attachmentThumbnail">
            <property name="minimumSize">
             <size>
              <width>50</width>
              <height>50</height>
             </size>
            </property>
            <property name="maximumSize">
             <size>
              <width>50</width>
              <height>50</height>
             </size>
            </property>
            <property name="text">
             <string/>
            </property>
            <property name="scaledContents">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="attachmentFileName">
            <property name="text">
             <string>image.png</string>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="horizontalSpacer_attachment">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>40</width>
              <height>20</height>
             </size>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="removeAttachmentBtn">
            <property name="text">
             <string>✕</string>
            </property>
            <property name="maximumSize">
             <size>
              <width>30</width>
              <height>30</height>
             </size>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <!-- SQL Script Panel (hidden by default) -->
       <item>
        <widget class="QGroupBox" name="sqlScriptGroupBox">
         <property name="title">
          <string>Generated SQL Script</string>
         </property>
         <property name="visible">
          <bool>false</bool>
         </property>
         <layout class="QVBoxLayout" name="verticalLayout_sqlScript">
          <item>
           <widget class="QPlainTextEdit" name="chatSqlOutput">
            <property name="maximumSize">
             <size>
              <width>16777215</width>
              <height>150</height>
             </size>
            </property>
            <property name="font">
             <font>
              <family>Courier New</family>
              <pointsize>9</pointsize>
             </font>
            </property>
            <property name="placeholderText">
             <string>SQL script will appear here...</string>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="horizontalLayout_sqlBtns">
            <item>
             <widget class="QPushButton" name="copySqlBtn">
              <property name="text">
               <string>📋 Copy SQL</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="runSqlFromChatBtn">
              <property name="text">
               <string>▶ Execute SQL</string>
              </property>
              <property name="styleSheet">
               <string notr="true">background-color: #4CAF50; color: white;</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="hideSqlPanelBtn">
              <property name="text">
               <string>Hide</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <!-- Message Input Area -->
       <item>
        <widget class="QGroupBox" name="groupBox_chatInput">
         <property name="title">
          <string>Message</string>
         </property>
         <layout class="QVBoxLayout" name="verticalLayout_chatInput">
          <item>
           <widget class="QPlainTextEdit" name="chatMessageInput">
            <property name="maximumSize">
             <size>
              <width>16777215</width>
              <height>80</height>
             </size>
            </property>
            <property name="placeholderText">
             <string>Type your message... (You can ask questions, describe GIS tasks, or attach images)</string>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="horizontalLayout_chatBtns">
            <item>
             <widget class="QPushButton" name="attachImageBtn">
              <property name="text">
