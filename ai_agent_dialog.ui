            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QLineEdit" name="interpreterApiKeyInput">
            <property name="echoMode">
             <enum>QLineEdit::Password</enum>
            </property>
            <property name="placeholderText">
             <string>Enter API key (not needed for Ollama)</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_interpreterModel">
            <property name="text">
             <string>Model:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QComboBox" name="interpreterModelCombo">
            <property name="editable">
             <bool>true</bool>
            </property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="label_interpreterBaseUrl">
            <property name="text">
             <string>Base URL:</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QLineEdit" name="interpreterBaseUrlInput">
            <property name="placeholderText">
             <string>Optional: Custom endpoint URL</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <!-- USE SAME MODEL CHECKBOX -->
       <item>
