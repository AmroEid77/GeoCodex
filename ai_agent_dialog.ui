              <property name="sizeHint" stdset="0">
               <size>
                <width>40</width>
                <height>20</height>
               </size>
              </property>
             </spacer>
            </item>
            <item>
             <widget class="QPushButton" name="clearChatBtn">
              <property name="text">
               <string>Clear Chat</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="sendMessageBtn">
              <property name="text">
               <string>Send ▶</string>
              </property>
              <property name="font">
               <font>
                <weight>75</weight>
                <bold>true</bold>
               </font>
              </property>
              <property name="styleSheet">
               <string notr="true">background-color: #2196F3; color: white; padding: 8px 16px;</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
