<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AIAgentDialog</class>
 <widget class="QDialog" name="AIAgentDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>650</width>
    <height>800</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>AI Spatial Agent</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout_main">
   <item>
    <widget class="QTabWidget" name="mainTabWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <!-- TAB 1: CONFIGURATION -->
     <widget class="QWidget" name="tab_config">
      <attribute name="title">
       <string>Configuration</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_config">
       <!-- INTERPRETER MODEL (Vision) -->
       <item>
        <widget class="QGroupBox" name="groupBox_interpreter">
         <property name="title">
          <string>Interpreter Model (Vision-capable)</string>
         </property>
         <layout class="QFormLayout" name="formLayout_interpreter">
          <item row="0" column="0">
           <widget class="QLabel" name="label_interpreterProvider">
            <property name="text">
             <string>Provider:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="interpreterProviderCombo">
            <item>
             <property name="text">
              <string>OpenAI (ChatGPT)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Anthropic (Claude)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Google (Gemini)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>NVIDIA AI</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>OpenRouter</string>
             </property>
            </item>
