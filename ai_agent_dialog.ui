   <!-- STATUS BAR AT BOTTOM -->
   <item>
    <widget class="QLabel" name="statusLabel">
     <property name="text">
      <string>Status: Ready.</string>
     </property>
     <property name="styleSheet">
      <string notr="true">color: gray; font-style: italic;</string>
     </property>
    </widget>
