       <item>
        <widget class="QGroupBox" name="groupBox_db">
         <property name="title">
          <string>Database Connection (PostGIS)</string>
         </property>
         <layout class="QFormLayout" name="formLayout_db">
          <item row="0" column="0">
           <widget class="QLabel" name="label_host">
            <property name="text">
             <string>Host:</string>
            </property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="dbHostInput">
            <property name="text">
             <string>localhost</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_port">
            <property name="text">
             <string>Port:</string>
            </property>
