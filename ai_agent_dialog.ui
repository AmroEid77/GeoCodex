          <item row="3" column="0">
           <widget class="QLabel" name="label_user">
            <property name="text">
             <string>Username:</string>
            </property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QLineEdit" name="dbUserInput"/>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="label_pass">
            <property name="text">
             <string>Password:</string>
