           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_dbname">
            <property name="text">
             <string>Database:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QLineEdit" name="dbNameInput"/>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="label_user">
            <property name="text">
             <string>Username:</string>
