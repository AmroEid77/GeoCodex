            </property>
            <property name="placeholderText">
             <string>Enter API key (not needed for Ollama)</string>
            </property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_coderModel">
            <property name="text">
             <string>Model:</string>
            </property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QComboBox" name="coderModelCombo">
            <property name="editable">
             <bool>true</bool>
            </property>
           </widget>
